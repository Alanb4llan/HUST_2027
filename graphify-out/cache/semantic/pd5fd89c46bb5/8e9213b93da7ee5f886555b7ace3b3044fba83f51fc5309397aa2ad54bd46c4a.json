{"nodes": [{"id": "docs_tips_and_tricks_setautobusoffrecovery", "label": "setAutoBusOffRecovery(true)", "file_type": "rationale", "source_file": "docs/tips-and-tricks.txt", "source_location": "line 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default false. Motor EMI spikes can push CAN into Bus Off and it stays dead until chip reset; true lets STM32 auto-rejoin when noise clears."}, {"id": "docs_tips_and_tricks_setirqpriority", "label": "setIRQPriority(5, 0) CAN interrupt", "file_type": "rationale", "source_file": "docs/tips-and-tricks.txt", "source_location": "line 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "STM32 priority 0 highest, 15 lowest (default 15). CAN IRQ should outrank slow UI/timers but sit below a critical emergency-stop pin interrupt; 5 is a safe automotive choice."}, {"id": "docs_tips_and_tricks_can_bus_emi_robustness", "label": "CAN bus EMI robustness", "file_type": "concept", "source_file": "docs/tips-and-tricks.txt", "source_location": "lines 1-14", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_tips_and_tricks_setautobusoffrecovery", "target": "docs_tips_and_tricks_can_bus_emi_robustness", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tips-and-tricks.txt", "source_location": "line 5", "weight": 1.0}, {"source": "docs_tips_and_tricks_setirqpriority", "target": "docs_tips_and_tricks_can_bus_emi_robustness", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/tips-and-tricks.txt", "source_location": "line 9", "weight": 1.0}, {"source": "docs_tips_and_tricks_can_bus_emi_robustness", "target": "graphify_out_converted_ext_int_pinouts_wiring_can_bus", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/tips-and-tricks.t