        )
        (padSet (footLayer Top)
          (connect (pad c477))
          (noconnect (pad c477))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c477))
          (noconnect (pad c477))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c477))
          (noconnect (pad c477))
        )
        (padSet (footLayer Inner)
